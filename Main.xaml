       <TextBlock x:Name="LocalNote" Text="仅统计本机已记录用量 · 不等于账户账单" Foreground="{DynamicResource Brush587598}" FontSize="10" TextWrapping="Wrap" Margin="0,12,0,0"/>
      </StackPanel>
     </Border>
    </StackPanel>
   </ScrollViewer>
