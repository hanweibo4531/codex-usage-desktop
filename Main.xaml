<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Codex 用量" Width="520" Height="830" MinWidth="470" MinHeight="620" WindowStyle="None" AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12" Foreground="{DynamicResource BrushEAF2FF}" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
  <Style x:Key="SettingsMenuStyle" TargetType="ContextMenu">
   <Setter Property="Background" Value="{DynamicResource Brush111B2B}"/><Setter Property="Foreground" Value="{DynamicResource BrushEAF2FF}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Brush23334A}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="6"/>
   <Setter Property="MinWidth" Value="236"/><Setter Property="FontSize" Value="12"/><Setter Property="HasDropShadow" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
    <Border x:Name="MenuPanel" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsMenuItemStyle" TargetType="MenuItem">
   <Setter Property="Foreground" Value="{DynamicResource BrushB4CAE6}"/><Setter Property="Padding" Value="11,8"/><Setter Property="MinHeight" Value="34"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
    <Border x:Name="MenuSurface" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
     <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
     <Path x:Name="Checkmark" Grid.Column="1" Data="M 0,4 L 3,7 L 9,0" Stroke="{DynamicResource Brush4BC9FF}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Hidden"/>
    </Grid></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuSurface" Property="Background" Value="{DynamicResource Brush172338}"/><Setter Property="Foreground" Value="{DynamicResource BrushEAF2FF}"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Checkmark" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="MenuDivider" TargetType="Separator"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Margin="10,5" Background="{DynamicResource Brush23334A}"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Button">
   <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
   <Setter Property="Foreground" Value="{DynamicResource Brush9BAEC8}"/><Setter Property="Background" Value="{DynamicResource Brush172338}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,7"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush234262}"/><Setter Property="Foreground" Value="{DynamicResource BrushEAF6FF}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush234262}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ToolTip"><Setter Property="Background" Value="{DynamicResource Brush172338}"/><Setter Property="Foreground" Value="{DynamicResource BrushEAF2FF}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush2A4461}"/></Style>
  <Style x:Key="ScrollPageButton" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
   <Setter Property="Width" Value="12"/><Setter Property="Background" Value="Transparent"/><Setter Property="Focusable" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Grid Background="Transparent"><Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
     <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb MinHeight="28"><Thumb.Template><ControlTemplate TargetType="Thumb">
      <Grid Background="Transparent"><Border x:Name="Grip" Width="4" HorizontalAlignment="Center" CornerRadius="3" Background="{DynamicResource Brush29425C}" Opacity="0.55"/></Grid>
      <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Width" Value="6"/><Setter TargetName="Grip" Property="Opacity" Value="0.9"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Width" Value="6"/><Setter TargetName="Grip" Property="Opacity" Value="1"/><Setter TargetName="Grip" Property="Background" Value="{DynamicResource Brush4BC9FF}"/></Trigger></ControlTemplate.Triggers>
     </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
    </Track></Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SlimScrollViewer" TargetType="ScrollViewer">
   <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollViewer"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}"/>
    <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Style="{StaticResource SlimScrollBar}" Orientation="Vertical" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
   </Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="{DynamicResource BrushB4CAE6}"/><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,1"/><Setter Property="MinHeight" Value="32"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
    <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="19"/></Grid.ColumnDefinitions>
     <ContentPresenter VerticalAlignment="Center"/><Path x:Name="SelectedMark" Grid.Column="1" Data="M 0,4 L 3,7 L 9,0" Stroke="{DynamicResource Brush4BC9FF}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Hidden"/>
    </Grid></Border>
    <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush172338}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush102A42}"/><Setter TargetName="SelectedMark" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="{DynamicResource Brush80D8FF}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="{DynamicResource BrushB4CAE6}"/><Setter Property="Background" Value="{DynamicResource Brush0D1625}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush23334A}"/><Setter Property="MinHeight" Value="32"/>
   <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton x:Name="DropDownToggle" BorderBrush="{TemplateBinding BorderBrush}" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="FieldBorder" Background="{DynamicResource Brush0D1625}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7"><Path x:Name="Chevron" Data="M 0,0 L 4,4 L 8,0" Stroke="{DynamicResource Brush769BC2}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" RenderTransformOrigin="0.5,0.5"/></Border>
      <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FieldBorder" Property="BorderBrush" Value="{DynamicResource Brush29638C}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="FieldBorder" Property="BorderBrush" Value="{DynamicResource Brush4BC9FF}"/><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers>
     </ControlTemplate></ToggleButton.Template>
    </ToggleButton>
    <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="11,6,31,6" VerticalAlignment="Center"/>
    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" VerticalOffset="6" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
     <Border x:Name="DropDownPanel" Background="{DynamicResource Brush111B2B}" BorderBrush="{DynamicResource Brush23334A}" BorderThickness="1" CornerRadius="10" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Padding="5">
      <ScrollViewer Style="{StaticResource SlimScrollViewer}" MaxHeight="252" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
     </Border>
    </Popup>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="DropDownToggle" Property="BorderBrush" Value="{DynamicResource Brush4BC9FF}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Brush111B2B}"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="18,15"/><Setter Property="Margin" Value="0,0,0,14"/><Setter Property="BorderBrush" Value="{DynamicResource Brush23334A}"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style x:Key="Metric" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Brush0D1625}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush23334A}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="12,14"/><Setter Property="Margin" Value="3"/></Style>
 </Window.Resources>
 <Border Background="{DynamicResource Brush080D16}" BorderBrush="{DynamicResource Brush314763}" BorderThickness="1" CornerRadius="16">
  <Grid Margin="22,18,22,14">
   <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
   <Grid x:Name="TitleBar" Background="Transparent" Margin="0,0,0,16">
    <Grid.ColumnDefinitions><ColumnDefinition Width="51"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Image x:Name="AppLogo" Width="42" Height="42" HorizontalAlignment="Left" VerticalAlignment="Center"/>
    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Codex 用量" FontWeight="SemiBold" FontSize="21"/><TextBlock Text="USAGE MONITOR  /  DESKTOP" Foreground="{DynamicResource Brush6682A3}" FontFamily="Consolas" FontSize="9" Margin="1,4,0,0"/></StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top"><Button x:Name="ThemeButton" Content="浅色" ToolTip="切换为浅色主题" Padding="8,5" Margin="0,0,3,0" Background="Transparent"/><Button x:Name="PinButton" Content="置顶" ToolTip="保持窗口在最前面" Margin="0,0,4,0" Padding="9,5" Background="Transparent"/><Button x:Name="HideButton" Content="—" ToolTip="收起到系统托盘" Margin="0,0,4,0" Padding="9,5" Background="Transparent"/><Button x:Name="CloseButton" Content="×" ToolTip="退出应用" Padding="9,5" Background="Transparent"/></StackPanel>
   </Grid>
   <ScrollViewer Style="{StaticResource SlimScrollViewer}" x:Name="UsageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,6,0">
     <Grid Margin="0,0,0,12"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="3" Height="12" Background="{DynamicResource Brush4BC9FF}" Margin="0,0,8,0"/><TextBlock Text="账户额度" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushB8CBE3}"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="ResetButton" Content="重置额度" FontSize="11" Padding="8,6" Margin="0,0,8,0" Background="{DynamicResource Brush163D5C}" Foreground="{DynamicResource BrushBCEAFF}"/><TextBlock x:Name="ResetCount" Foreground="{DynamicResource Brush56C5F5}" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/><Button x:Name="RefreshButton" Content="↻  刷新" Foreground="{DynamicResource Brush80D8FF}" Padding="11,6" Background="{DynamicResource Brush102A42}"/></StackPanel></Grid>
     <Border Style="{StaticResource Card}" Padding="12,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="ScheduleSummary" Text="定时请求 · 未启用" Foreground="{DynamicResource BrushEAF2FF}" FontSize="12"/><TextBlock x:Name="ScheduleLast" Foreground="{DynamicResource Brush849DBD}" FontSize="10" Margin="0,5,8,0" TextWrapping="Wrap"/></StackPanel><Button x:Name="ScheduleButton" Grid.Column="1" Content="设置定时" Padding="10,6" VerticalAlignment="Center"/></Grid></Border>
     <StackPanel x:Name="WeeklyQuotaPanel"/>
     <StackPanel x:Name="QuotaCards"/>
     <Border Style="{StaticResource Card}">
      <StackPanel>
       <Grid><StackPanel Orientation="Horizontal"><Border Width="3" Height="14" Background="{DynamicResource Brush887BFF}" Margin="0,0,9,0"/><TextBlock Text="本机用量" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/></StackPanel><Button x:Name="ExportButton" Content="导出 CSV ↗" HorizontalAlignment="Right" Padding="8,4" Background="Transparent" Foreground="{DynamicResource Brush769BC2}" FontSize="11"/></Grid>
       <Grid Margin="0,15,0,13"><StackPanel Orientation="Horizontal"><Button x:Name="TodayButton" Content="今天" Padding="8,7" Background="{DynamicResource Brush163D5C}" Foreground="{DynamicResource BrushBCEAFF}" Margin="0,0,4,0"/><Button x:Name="WeekButton" Content="近 7 天" Padding="8,7" Background="Transparent"/><Button x:Name="MonthButton" Content="近 30 天" Padding="8,7" Background="Transparent"/></StackPanel><ComboBox x:Name="ModelFilter" HorizontalAlignment="Right" Width="150" VerticalAlignment="Center"/></Grid>
       <UniformGrid Columns="3" Margin="-3,0,-3,0">
        <Border Style="{StaticResource Metric}"><StackPanel><TextBlock Text="用量记录" Foreground="{DynamicResource Brush7F97B6}" FontSize="10"/><TextBlock x:Name="RequestCount" Text="—" FontFamily="Consolas, Microsoft YaHei UI" FontSize="26" FontWeight="Bold" Margin="0,7,0,0"/></StackPanel></Border>
        <Border Style="{StaticResource Metric}"><StackPanel><TextBlock Text="输入缓存占比" Foreground="{DynamicResource Brush7F97B6}" FontSize="10"/><TextBlock x:Name="CacheRatio" Text="—" FontFamily="Consolas" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource BrushACA1FF}" Margin="0,7,0,0"/></StackPanel></Border>
        <Border Style="{StaticResource Metric}" BorderBrush="{DynamicResource Brush21567B}" Background="{DynamicResource Brush0E2438}"><StackPanel><TextBlock Text="Token 总量" Foreground="{DynamicResource Brush6BA5CC}" FontSize="10"/><TextBlock x:Name="TokenTotal" Text="—" FontFamily="Consolas, Microsoft YaHei UI" FontSize="23" FontWeight="Bold" Foreground="{DynamicResource Brush61D0FF}" Margin="0,9,0,0"/></StackPanel></Border>
       </UniformGrid>
       <Grid Margin="0,17,0,8"><TextBlock x:Name="ChartTitle" Text="今日用量分布" Foreground="{DynamicResource Brush92AACA}" FontSize="11"/><TextBlock Text="TOKEN ACTIVITY" FontFamily="Consolas" HorizontalAlignment="Right" Foreground="{DynamicResource Brush506E94}" FontSize="9"/></Grid>
       <Grid Height="48"><StackPanel VerticalAlignment="Stretch"><Border Height="1" Background="{DynamicResource Brush1B2A40}" Margin="0,0,0,22"/><Border Height="1" Background="{DynamicResource Brush1B2A40}" Margin="0,0,0,22"/><Border Height="1" Background="{DynamicResource Brush243954}"/></StackPanel><Grid x:Name="Chart" Height="45" VerticalAlignment="Bottom"/></Grid>
       <Grid Margin="0,5,0,18"><TextBlock x:Name="ChartStart" Text="00:00" Foreground="{DynamicResource Brush567293}" FontFamily="Consolas" FontSize="9"/><TextBlock x:Name="ChartEnd" Text="23:00" HorizontalAlignment="Right" Foreground="{DynamicResource Brush567293}" FontFamily="Consolas" FontSize="9"/></Grid>
       <Grid Margin="0,0,0,12"><TextBlock Text="最近用量" FontWeight="SemiBold"/><TextBlock x:Name="LocalUpdated" HorizontalAlignment="Right" Foreground="{DynamicResource Brush6682A3}" FontSize="10"/></Grid>
       <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions><TextBlock Grid.Column="1" Text="模型" Foreground="{DynamicResource Brush587598}" FontSize="10"/><TextBlock Grid.Column="2" Text="TOKENS" FontFamily="Consolas" Foreground="{DynamicResource Brush587598}" FontSize="10" TextAlignment="Right"/><TextBlock Grid.Column="3" Text="时间" Foreground="{DynamicResource Brush587598}" FontSize="10" TextAlignment="Right"/></Grid>
       <Border Height="1" Background="{DynamicResource Brush23344D}"/>
