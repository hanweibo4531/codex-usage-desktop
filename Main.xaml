<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Codex 用量" Width="520" Height="830" MinWidth="470" MinHeight="620" WindowStyle="None" AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12" Foreground="#EAF2FF" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#9BAEC8"/><Setter Property="Background" Value="#172338"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,7"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#234262"/><Setter Property="Foreground" Value="#EAF6FF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Background" Value="#234262"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ToolTip"><Setter Property="Background" Value="#172338"/><Setter Property="Foreground" Value="#EAF2FF"/><Setter Property="BorderBrush" Value="#2A4461"/></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#DAE9FF"/><Setter Property="Padding" Value="10,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBorder" Background="#132036" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#234262"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#163D5C"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#B4CAE6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#172338" BorderBrush="#263953" BorderThickness="1" CornerRadius="6" Padding="10,7"><TextBlock Text="⌄" HorizontalAlignment="Right" Foreground="#68BEE8"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" Margin="10,6,25,6" VerticalAlignment="Center"/><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#132036" BorderBrush="#2C4B6B" BorderThickness="1" CornerRadius="6" MinWidth="156" Padding="3"><ScrollViewer MaxHeight="260"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#29425C" CornerRadius="3" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#111B2B"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="18,15"/><Setter Property="Margin" Value="0,0,0,14"/><Setter Property="BorderBrush" Value="#23334A"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style x:Key="Metric" TargetType="Border"><Setter Property="Background" Value="#0D1625"/><Setter Property="BorderBrush" Value="#23334A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="12,14"/><Setter Property="Margin" Value="3"/></Style>
 </Window.Resources>
 <Border Background="#080D16" BorderBrush="#314763" BorderThickness="1" CornerRadius="16">
  <Grid Margin="22,18,22,14">
   <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
   <Grid x:Name="TitleBar" Background="Transparent" Margin="0,0,0,16">
    <Grid.ColumnDefinitions><ColumnDefinition Width="51"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Background="#112B42" BorderBrush="#29638C" BorderThickness="1" CornerRadius="10" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="&gt;_" FontFamily="Consolas" FontSize="21" FontWeight="Bold" Foreground="#4BC9FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Codex 用量" FontWeight="SemiBold" FontSize="21"/><TextBlock Text="USAGE MONITOR  /  DESKTOP" Foreground="#6682A3" FontFamily="Consolas" FontSize="9" Margin="1,4,0,0"/></StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top"><Button x:Name="PinButton" Content="置顶" ToolTip="保持窗口在最前面" Margin="0,0,4,0" Padding="9,5" Background="Transparent"/><Button x:Name="HideButton" Content="—" ToolTip="收起到系统托盘" Margin="0,0,4,0" Padding="9,5" Background="Transparent"/><Button x:Name="CloseButton" Content="×" ToolTip="退出应用" Padding="9,5" Background="Transparent"/></StackPanel>
   </Grid>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,6,0">
     <Grid Margin="0,0,0,12"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="3" Height="12" Background="#4BC9FF" Margin="0,0,8,0"/><TextBlock Text="账户额度" FontWeight="SemiBold" FontSize="12" Foreground="#B8CBE3"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock x:Name="ResetCount" Foreground="#56C5F5" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/><Button x:Name="RefreshButton" Content="↻  刷新" Foreground="#80D8FF" Padding="11,6" Background="#102A42"/></StackPanel></Grid>
     <StackPanel x:Name="QuotaCards"/>
     <Border Style="{StaticResource Card}">
      <StackPanel>
       <Grid><StackPanel Orientation="Horizontal"><Border Width="3" Height="14" Background="#887BFF" Margin="0,0,9,0"/><TextBlock Text="本机用量" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/></StackPanel><Button x:Name="ExportButton" Content="导出 CSV ↗" HorizontalAlignment="Right" Padding="8,4" Background="Transparent" Foreground="#769BC2" FontSize="11"/></Grid>
       <Grid Margin="0,15,0,13"><StackPanel Orientation="Horizontal"><Button x:Name="TodayButton" Content="今天" Background="#163D5C" Foreground="#BCEAFF" Margin="0,0,4,0"/><Button x:Name="WeekButton" Content="近 7 天" Background="Transparent"/></StackPanel><ComboBox x:Name="ModelFilter" HorizontalAlignment="Right" Width="156" VerticalAlignment="Center"/></Grid>
       <UniformGrid Columns="3" Margin="-3,0,-3,0">
        <Border Style="{StaticResource Metric}"><StackPanel><TextBlock Text="用量记录" Foreground="#7F97B6" FontSize="10"/><TextBlock x:Name="RequestCount" Text="—" FontFamily="Consolas, Microsoft YaHei UI" FontSize="26" FontWeight="Bold" Margin="0,7,0,0"/></StackPanel></Border>
        <Border Style="{StaticResource Metric}"><StackPanel><TextBlock Text="输入缓存占比" Foreground="#7F97B6" FontSize="10"/><TextBlock x:Name="CacheRatio" Text="—" FontFamily="Consolas" FontSize="26" FontWeight="Bold" Foreground="#ACA1FF" Margin="0,7,0,0"/></StackPanel></Border>
        <Border Style="{StaticResource Metric}" BorderBrush="#21567B" Background="#0E2438"><StackPanel><TextBlock Text="Token 总量" Foreground="#6BA5CC" FontSize="10"/><TextBlock x:Name="TokenTotal" Text="—" FontFamily="Consolas, Microsoft YaHei UI" FontSize="23" FontWeight="Bold" Foreground="#61D0FF" Margin="0,9,0,0"/></StackPanel></Border>
       </UniformGrid>
       <Grid Margin="0,17,0,8"><TextBlock x:Name="ChartTitle" Text="今日用量分布" Foreground="#92AACA" FontSize="11"/><TextBlock Text="TOKEN ACTIVITY" FontFamily="Consolas" HorizontalAlignment="Right" Foreground="#506E94" FontSize="9"/></Grid>
       <Grid Height="48"><StackPanel VerticalAlignment="Stretch"><Border Height="1" Background="#1B2A40" Margin="0,0,0,22"/><Border Height="1" Background="#1B2A40" Margin="0,0,0,22"/><Border Height="1" Background="#243954"/></StackPanel><Grid x:Name="Chart" Height="45" VerticalAlignment="Bottom"/></Grid>
       <Grid Margin="0,5,0,18"><TextBlock x:Name="ChartStart" Text="00:00" Foreground="#567293" FontFamily="Consolas" FontSize="9"/><TextBlock x:Name="ChartEnd" Text="23:00" HorizontalAlignment="Right" Foreground="#567293" FontFamily="Consolas" FontSize="9"/></Grid>
       <Grid Margin="0,0,0,12"><TextBlock Text="最近用量" FontWeight="SemiBold"/><TextBlock x:Name="LocalUpdated" HorizontalAlignment="Right" Foreground="#6682A3" FontSize="10"/></Grid>
       <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions><TextBlock Grid.Column="1" Text="模型" Foreground="#587598" FontSize="10"/><TextBlock Grid.Column="2" Text="TOKENS" FontFamily="Consolas" Foreground="#587598" FontSize="10" TextAlignment="Right"/><TextBlock Grid.Column="3" Text="时间" Foreground="#587598" FontSize="10" TextAlignment="Right"/></Grid>
       <Border Height="1" Background="#23344D"/>
       <StackPanel x:Name="UsageRows" Margin="0,5,0,0"/>
       <TextBlock x:Name="EmptyState" Text="正在读取本机用量…" Foreground="#7F99BA" TextWrapping="Wrap" Margin="0,18"/>
       <TextBlock x:Name="LocalNote" Text="仅统计本机已记录用量 · 不等于账户账单" Foreground="#587598" FontSize="10" TextWrapping="Wrap" Margin="0,12,0,0"/>
      </StackPanel>
     </Border>
    </StackPanel>
   </ScrollViewer>
   <Grid Grid.Row="2" Margin="0,11,0,0"><TextBlock x:Name="StatusText" Text="●  正在连接" Foreground="#4BC9FF" FontSize="10" VerticalAlignment="Center"/><Button x:Name="SettingsButton" Content="设置" Padding="8,3" Background="Transparent" HorizontalAlignment="Right" FontSize="10"/></Grid>
  </Grid>
 </Border>
</Window>